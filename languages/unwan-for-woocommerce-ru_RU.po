msgstr "Заголовок сводки по доставке"

#: includes/Admin/Settings.php:177
msgid "Billing picker heading"
msgstr "Заголовок выбора платёжного адреса"

#: includes/Admin/Settings.php:178
msgid "Shipping picker heading"
msgstr "Заголовок выбора адреса доставки"

#: includes/Admin/Settings.php:179
msgid "Search placeholder"
msgstr "Подсказка в поле поиска"

#: includes/Admin/Settings.php:180
