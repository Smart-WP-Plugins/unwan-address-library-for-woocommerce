#: includes/Admin/Settings.php:45
msgid "Unwan"
msgstr "Unwan"

#: includes/Admin/Settings.php:66
msgid "Control where Unwan appears and how checkout addresses are stored."
msgstr "Choisissez où Unwan apparaît et comment les adresses saisies à la commande sont enregistrées."

#: includes/Admin/Settings.php:71
msgid "Billing checkout selector"
msgstr "Sélecteur de facturation à la commande"

#: includes/Admin/Settings.php:72
msgid "Let customers choose any address-book entry for billing"
msgstr "Permettre aux clients de choisir n’importe quelle adresse du carnet pour la facturation"

#: includes/Admin/Settings.php:78
msgid "Shipping checkout selector"
msgstr "Sélecteur de livraison à la commande"

#: includes/Admin/Settings.php:79
msgid "Let customers choose any address-book entry for shipping"
msgstr "Permettre aux clients de choisir n’importe quelle adresse du carnet pour la livraison"

#: includes/Admin/Settings.php:85
msgid "Additional address limit"
msgstr "Limite d’adresses supplémentaires"

#: includes/Admin/Settings.php:86
msgid "Maximum additional addresses per customer. Billing and shipping defaults are not counted. Use 0 for unlimited."
msgstr "Nombre maximal d’adresses supplémentaires par client. Les adresses de facturation et de livraison par défaut ne sont pas comptées. Utilisez 0 pour un nombre illimité."

#: includes/Admin/Settings.php:97
msgid "Address search threshold"
msgstr "Seuil de recherche d’adresses"

#: includes/Admin/Settings.php:98
msgid "Show search in checkout and My Account when a customer has more than this many addresses. Use 0 to always show it."
msgstr "Afficher la recherche à la commande et dans Mon compte lorsqu’un client dépasse ce nombre d’adresses. Utilisez 0 pour toujours l’afficher."

#: includes/Admin/Settings.php:110
msgid "Save checkout addresses"
msgstr "Enregistrer les adresses saisies à la commande"

#: includes/Admin/Settings.php:111
msgid "Add a new address entered at checkout to the customer’s address book"
msgstr "Ajouter au carnet d’adresses du client toute nouvelle adresse saisie à la commande"

#: includes/Admin/Settings.php:117
msgid "New address defaults"
msgstr "Valeurs par défaut des nouvelles adresses"

#: includes/Admin/Settings.php:118
msgid "Choose whether a new address entered at checkout should replace the matching billing or shipping profile default."
msgstr "Choisissez si une nouvelle adresse saisie à la commande doit remplacer l’adresse de facturation ou de livraison par défaut du profil."

#: includes/Admin/Settings.php:123
msgid "Keep the current defaults"
msgstr "Conserver les adresses par défaut actuelles"

#: includes/Admin/Settings.php:124
msgid "Make the new address the matching default"
msgstr "Définir la nouvelle adresse comme adresse par défaut correspondante"

#: includes/Admin/Settings.php:132
msgid "Appearance"
msgstr "Apparence"

#: includes/Admin/Settings.php:133
msgid "These values are exposed through scoped Unwan CSS variables and do not restyle the active theme."
msgstr "Ces valeurs sont exposées via des variables CSS Unwan cloisonnées et ne modifient pas les styles du thème actif."

#: includes/Admin/Settings.php:138
msgid "Color mode"
msgstr "Mode de couleur"

#: includes/Admin/Settings.php:143
msgid "Light"
msgstr "Clair"

#: includes/Admin/Settings.php:144
msgid "Dark"
msgstr "Sombre"

#: includes/Admin/Settings.php:145
msgid "Follow the customer’s device"
msgstr "Suivre l’appareil du client"

#: includes/Admin/Settings.php:149
msgid "Accent color"
msgstr "Couleur d’accentuation"

#: includes/Admin/Settings.php:160
msgid "Text and labels"
msgstr "Textes et libellés"

#: includes/Admin/Settings.php:161
msgid "Customize customer-facing interface copy. Leave a field empty to show the default text, translated into each customer’s language."
msgstr "Personnalisez les textes affichés aux clients. Laissez un champ vide pour afficher le texte par défaut, traduit dans la langue de chaque client."

