#: includes/Admin/Settings.php:44
msgid "Unwan"
msgstr "Unwan"

#: includes/Admin/Settings.php:64
msgid "Control where Unwan appears and how checkout addresses are stored."
msgstr "Bepaal waar Unwan verschijnt en hoe adressen van het afrekenen worden opgeslagen."

#: includes/Admin/Settings.php:69
msgid "Billing checkout selector"
msgstr "Factuurkiezer bij het afrekenen"

#: includes/Admin/Settings.php:70
msgid "Let customers choose any address-book entry for billing"
msgstr "Klanten elk adres uit het adresboek laten kiezen voor facturering"

#: includes/Admin/Settings.php:76
msgid "Shipping checkout selector"
msgstr "Verzendkiezer bij het afrekenen"

#: includes/Admin/Settings.php:77
msgid "Let customers choose any address-book entry for shipping"
msgstr "Klanten elk adres uit het adresboek laten kiezen voor verzending"

#: includes/Admin/Settings.php:83
msgid "Additional address limit"
msgstr "Limiet voor extra adressen"

#: includes/Admin/Settings.php:84
msgid "Maximum additional addresses per customer. Billing and shipping defaults are not counted. Use 0 for unlimited."
msgstr "Maximumaantal extra adressen per klant. Standaard factuur- en verzendadressen tellen niet mee. Gebruik 0 voor onbeperkt."

#: includes/Admin/Settings.php:95
msgid "Address search threshold"
msgstr "Drempel voor adreszoeken"

#: includes/Admin/Settings.php:96
msgid "Show search in checkout and My Account when a customer has more than this many addresses. Use 0 to always show it."
msgstr "Toon het zoekveld bij het afrekenen en in Mijn account wanneer een klant meer adressen heeft dan dit aantal. Gebruik 0 om het altijd te tonen."

#: includes/Admin/Settings.php:108
msgid "Save checkout addresses"
msgstr "Adressen van het afrekenen opslaan"

#: includes/Admin/Settings.php:109
msgid "Add a new address entered at checkout to the customer’s address book"
msgstr "Elk nieuw adres dat bij het afrekenen wordt ingevoerd toevoegen aan het adresboek van de klant"

#: includes/Admin/Settings.php:115
msgid "New address defaults"
msgstr "Standaardinstelling voor nieuwe adressen"

#: includes/Admin/Settings.php:116
msgid "Choose whether a new address entered at checkout should replace the matching billing or shipping profile default."
msgstr "Kies of een nieuw adres dat bij het afrekenen wordt ingevoerd het bijbehorende standaard factuur- of verzendadres in het profiel moet vervangen."

#: includes/Admin/Settings.php:121
msgid "Keep the current defaults"
msgstr "De huidige standaardadressen behouden"

#: includes/Admin/Settings.php:122
