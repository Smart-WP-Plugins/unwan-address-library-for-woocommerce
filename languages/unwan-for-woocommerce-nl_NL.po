msgstr "Accentkleur"

#: includes/Admin/Settings.php:167
msgid "Text and labels"
msgstr "Teksten en labels"

#: includes/Admin/Settings.php:168
msgid "Customize customer-facing interface copy. Leave a field empty to show the default text, translated into each customer’s language."
msgstr "Pas de teksten aan die klanten zien. Laat een veld leeg om de standaardtekst te tonen, vertaald in de taal van elke klant."

