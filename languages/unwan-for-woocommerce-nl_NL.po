#: includes/Admin/Settings.php:187
msgid "Data removal"
msgstr "Gegevens verwijderen"

#: includes/Admin/Settings.php:188
msgid "Choose whether customer address-book data and plugin settings should remain after uninstalling Unwan."
msgstr "Kies of de adresboekgegevens van klanten en de plugin-instellingen behouden moeten blijven na het verwijderen van Unwan."

#: includes/Admin/Settings.php:193
msgid "Uninstall cleanup"
msgstr "Opschonen bij verwijderen"

#: includes/Admin/Settings.php:194
msgid "Permanently remove all Unwan settings and additional customer addresses when the plugin is deleted"
msgstr "Alle Unwan-instellingen en extra klantadressen definitief verwijderen wanneer de plugin wordt verwijderd"

#: includes/Admin/Settings.php:195
msgid "WooCommerce billing and shipping profile addresses are not removed."
msgstr "De factuur- en verzendadressen in het WooCommerce-profiel worden niet verwijderd."

#: includes/Admin/Settings.php:334
msgid "Addresses"
msgstr "Adressen"

#: includes/Admin/Settings.php:335
msgid "Your billing default, shipping default, and additional addresses form one address book. Every address can be used anywhere at checkout."
msgstr "Je standaard factuuradres, je standaard verzendadres en je extra adressen vormen één adresboek. Elk adres kan overal bij het afrekenen worden gebruikt."

