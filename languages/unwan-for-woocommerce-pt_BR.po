#: includes/Admin/Settings.php:45
msgid "Unwan"
msgstr "Unwan"

#: includes/Admin/Settings.php:66
msgid "Control where Unwan appears and how checkout addresses are stored."
msgstr "Defina onde o Unwan aparece e como os endereços informados na finalização são salvos."

#: includes/Admin/Settings.php:71
msgid "Billing checkout selector"
msgstr "Seletor de cobrança na finalização"

#: includes/Admin/Settings.php:72
msgid "Let customers choose any address-book entry for billing"
msgstr "Permitir que os clientes escolham qualquer endereço do catálogo para cobrança"

#: includes/Admin/Settings.php:78
msgid "Shipping checkout selector"
msgstr "Seletor de entrega na finalização"

#: includes/Admin/Settings.php:79
msgid "Let customers choose any address-book entry for shipping"
msgstr "Permitir que os clientes escolham qualquer endereço do catálogo para entrega"

#: includes/Admin/Settings.php:85
msgid "Additional address limit"
msgstr "Limite de endereços adicionais"

#: includes/Admin/Settings.php:86
msgid "Maximum additional addresses per customer. Billing and shipping defaults are not counted. Use 0 for unlimited."
msgstr "Número máximo de endereços adicionais por cliente. Os endereços padrão de cobrança e entrega não são contados. Use 0 para ilimitado."

#: includes/Admin/Settings.php:97
msgid "Address search threshold"
msgstr "Limite para a busca de endereços"

#: includes/Admin/Settings.php:98
msgid "Show search in checkout and My Account when a customer has more than this many addresses. Use 0 to always show it."
msgstr "Mostrar a busca na finalização e em Minha conta quando o cliente tiver mais endereços do que esta quantidade. Use 0 para sempre mostrar."

#: includes/Admin/Settings.php:110
msgid "Save checkout addresses"
msgstr "Salvar endereços da finalização"

#: includes/Admin/Settings.php:111
msgid "Add a new address entered at checkout to the customer’s address book"
msgstr "Adicionar ao catálogo do cliente cada novo endereço informado na finalização"

#: includes/Admin/Settings.php:117
msgid "New address defaults"
msgstr "Padrões para novos endereços"

#: includes/Admin/Settings.php:118
msgid "Choose whether a new address entered at checkout should replace the matching billing or shipping profile default."
msgstr "Escolha se um novo endereço informado na finalização deve substituir o endereço padrão de cobrança ou entrega do perfil."

#: includes/Admin/Settings.php:123
msgid "Keep the current defaults"
msgstr "Manter os padrões atuais"

#: includes/Admin/Settings.php:124
msgid "Make the new address the matching default"
msgstr "Tornar o novo endereço o padrão correspondente"

#: includes/Admin/Settings.php:132
msgid "Appearance"
msgstr "Aparência"

#: includes/Admin/Settings.php:133
msgid "These values are exposed through scoped Unwan CSS variables and do not restyle the active theme."
msgstr "Esses valores são expostos por variáveis CSS do Unwan com escopo próprio e não alteram o estilo do tema ativo."

