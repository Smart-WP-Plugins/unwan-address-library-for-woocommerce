#: includes/Admin/Settings.php:44
msgid "Unwan"
msgstr "Unwan"

#: includes/Admin/Settings.php:64
msgid "Control where Unwan appears and how checkout addresses are stored."
msgstr "Scegli dove appare Unwan e come vengono salvati gli indirizzi inseriti al pagamento."

#: includes/Admin/Settings.php:69
msgid "Billing checkout selector"
msgstr "Selettore di fatturazione al pagamento"

#: includes/Admin/Settings.php:70
msgid "Let customers choose any address-book entry for billing"
msgstr "Consenti ai clienti di scegliere qualsiasi indirizzo della rubrica per la fatturazione"

#: includes/Admin/Settings.php:76
msgid "Shipping checkout selector"
msgstr "Selettore di spedizione al pagamento"

#: includes/Admin/Settings.php:77
msgid "Let customers choose any address-book entry for shipping"
msgstr "Consenti ai clienti di scegliere qualsiasi indirizzo della rubrica per la spedizione"

#: includes/Admin/Settings.php:83
msgid "Additional address limit"
msgstr "Limite di indirizzi aggiuntivi"

#: includes/Admin/Settings.php:84
msgid "Maximum additional addresses per customer. Billing and shipping defaults are not counted. Use 0 for unlimited."
msgstr "Numero massimo di indirizzi aggiuntivi per cliente. Gli indirizzi predefiniti di fatturazione e spedizione non vengono conteggiati. Usa 0 per illimitati."

#: includes/Admin/Settings.php:95
msgid "Address search threshold"
msgstr "Soglia di ricerca degli indirizzi"

#: includes/Admin/Settings.php:96
msgid "Show search in checkout and My Account when a customer has more than this many addresses. Use 0 to always show it."
msgstr "Mostra la ricerca al pagamento e in Il mio account quando un cliente supera questo numero di indirizzi. Usa 0 per mostrarla sempre."

#: includes/Admin/Settings.php:108
msgid "Save checkout addresses"
msgstr "Salva gli indirizzi inseriti al pagamento"

#: includes/Admin/Settings.php:109
msgid "Add a new address entered at checkout to the customer’s address book"
msgstr "Aggiungi alla rubrica del cliente ogni nuovo indirizzo inserito al pagamento"

#: includes/Admin/Settings.php:115
msgid "New address defaults"
msgstr "Predefiniti per i nuovi indirizzi"

#: includes/Admin/Settings.php:116
msgid "Choose whether a new address entered at checkout should replace the matching billing or shipping profile default."
msgstr "Scegli se un nuovo indirizzo inserito al pagamento debba sostituire l’indirizzo predefinito di fatturazione o spedizione del profilo."

#: includes/Admin/Settings.php:121
msgid "Keep the current defaults"
msgstr "Mantieni gli indirizzi predefiniti attuali"

#: includes/Admin/Settings.php:122
msgid "Make the new address the matching default"
msgstr "Imposta il nuovo indirizzo come predefinito corrispondente"

#: includes/Admin/Settings.php:130
msgid "Appearance"
msgstr "Aspetto"

#: includes/Admin/Settings.php:131
msgid "These values are exposed through scoped Unwan CSS variables and do not restyle the active theme."
msgstr "Questi valori sono esposti tramite variabili CSS di Unwan con ambito dedicato e non modificano lo stile del tema attivo."

#: includes/Admin/Settings.php:136
msgid "Color mode"
msgstr "Modalità colore"

#: includes/Admin/Settings.php:141
msgid "Light"
msgstr "Chiara"

#: includes/Admin/Settings.php:142
msgid "Dark"
msgstr "Scura"

#: includes/Admin/Settings.php:143
msgid "Follow the customer’s device"
msgstr "Segui il dispositivo del cliente"

#: includes/Admin/Settings.php:147
msgid "Accent color"
msgstr "Colore di accento"

#: includes/Admin/Settings.php:158
msgid "Text and labels"
msgstr "Testi ed etichette"

#: includes/Admin/Settings.php:159
msgid "Customize customer-facing interface copy. Translations can still override the defaults."
msgstr "Personalizza i testi dell’interfaccia visibili ai clienti. Le traduzioni possono comunque sovrascrivere i valori predefiniti."

#: includes/Admin/Settings.php:163
msgid "Address-book page title"
msgstr "Titolo della pagina della rubrica"

#: includes/Admin/Settings.php:163 includes/Admin/Settings.php:371
