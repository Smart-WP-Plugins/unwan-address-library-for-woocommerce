msgstr "Link di ritorno"

#: includes/Admin/Settings.php:171
msgid "Save button"
msgstr "Pulsante di salvataggio"

#: includes/Admin/Settings.php:172
msgid "Cancel action"
msgstr "Azione di annullamento"

#: includes/Admin/Settings.php:173
msgid "Empty-state heading"
msgstr "Titolo dello stato vuoto"

#: includes/Admin/Settings.php:174
msgid "Empty-state description"
msgstr "Descrizione dello stato vuoto"

#: includes/Admin/Settings.php:175
msgid "Billing summary heading"
msgstr "Titolo del riepilogo di fatturazione"

#: includes/Admin/Settings.php:176
msgid "Shipping summary heading"
msgstr "Titolo del riepilogo di spedizione"

#: includes/Admin/Settings.php:177
