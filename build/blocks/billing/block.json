{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "unwan/billing-selector",
  "version": "1.0.0",
  "title": "Billing Address Book",
  "category": "woocommerce",
  "icon": "location-alt",
  "description": "Lets signed-in customers choose a saved billing address.",
  "supports": {
    "html": false,
    "multiple": false,
    "inserter": false,
    "reusable": false
  },
  "parent": [
    "woocommerce/checkout-billing-address-block"
  ],
  "attributes": {
    "lock": {
      "type": "object",
      "default": {
        "remove": true,
        "move": true
      }
    }
  },
  "textdomain": "unwan-for-woocommerce"
}